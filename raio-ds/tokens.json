{
  "$description": "raio Design System — tokens extraídos do Figma (Raio - Hacka, node 58:58)",
  "color": {
    "brand": {
      "blue":   { "$type": "color", "$value": "#0451FF" },
      "lime":   { "$type": "color", "$value": "#CEFF05" },
      "purple": { "$type": "color", "$value": "#D785FE" }
    },
    "neutral": {
      "black": { "$type": "color", "$value": "#000000" },
      "800":   { "$type": "color", "$value": "#282828" },
      "500":   { "$type": "color", "$value": "#808080", "$description": "Texto secundário em cards (light)" },
      "400":   { "$type": "color", "$value": "#A0A0A0", "$description": "Labels, placeholders, texto muted" },
      "350":   { "$type": "color", "$value": "#999999", "$description": "Placeholder do Input/Default" },
      "300":   { "$type": "color", "$value": "#D9D9D9", "$description": "Borda do Input/Default" },
      "200":   { "$type": "color", "$value": "#E6E6E6", "$description": "Bordas de inputs, tag neutra" },
      "100":   { "$type": "color", "$value": "#F5F5F5" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "dark": {
      "bg":      { "$type": "color", "$value": "#080810" },
      "surface": { "$type": "color", "$value": "#12121E" },
      "border":  { "$type": "color", "$value": "#28283C" }
    },
    "feedback": {
      "success":        { "$type": "color", "$value": "#33B233" },
      "success-bg":     { "$type": "color", "$value": "#E5FFE5" },
      "success-bright": { "$type": "color", "$value": "#33E566", "$description": "Texto do stat-badge (dark)" },
      "success-strong": { "$type": "color", "$value": "#1ACC4D", "$description": "Fundo do stat-badge (dark)" },
      "warning":        { "$type": "color", "$value": "#FFB200" },
      "warning-bg":     { "$type": "color", "$value": "#FFF7E0" },
      "error":          { "$type": "color", "$value": "#FF4D4D" },
      "error-input":    { "$type": "color", "$value": "#FF3333", "$description": "Borda/label do Input/Error" },
      "error-bg":       { "$type": "color", "$value": "#FFEBEB" },
      "error-field":    { "$type": "color", "$value": "#DC3232", "$description": "Componente Input, State=Error" }
    }
  },
  "font": {
    "family": { "base": { "$type": "fontFamily", "$value": "Space Grotesk" } },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "display":    { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "64px", "fontWeight": 700 } },
    "heading-1":  { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "48px", "fontWeight": 700 } },
    "heading-2":  { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "36px", "fontWeight": 700 } },
    "heading-3":  { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "28px", "fontWeight": 500 } },
    "section":    { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "24px", "fontWeight": 700 } },
    "body-large": { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "18px", "fontWeight": 400 } },
    "body":       { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "16px", "fontWeight": 400 } },
    "body-small": { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "14px", "fontWeight": 400 } },
    "label":      { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "12px", "fontWeight": 500 } },
    "caption":    { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "11px", "fontWeight": 500 } },
    "overline":   { "$type": "typography", "$value": { "fontFamily": "Space Grotesk", "fontSize": "11px", "fontWeight": 700, "letterSpacing": "1.5px", "textCase": "uppercase" } }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": "5px",  "$description": "Checkbox" },
    "sm":   { "$type": "dimension", "$value": "6px",  "$description": "Botões pequenos em card" },
    "md":   { "$type": "dimension", "$value": "8px",  "$description": "Botões, inputs" },
    "lg":   { "$type": "dimension", "$value": "10px", "$description": "Alertas, botão do modal" },
    "xl":   { "$type": "dimension", "$value": "12px", "$description": "Navbar, swatches" },
    "2xl":  { "$type": "dimension", "$value": "16px", "$description": "Cards, seções" },
    "3xl":  { "$type": "dimension", "$value": "20px", "$description": "Modal" },
    "pill": { "$type": "dimension", "$value": "100px" }
  },
  "border-width": {
    "thin":   { "$type": "dimension", "$value": "1px" },
    "base":   { "$type": "dimension", "$value": "1.5px" },
    "strong": { "$type": "dimension", "$value": "2px", "$description": "Focus, botão outline" }
  },
  "shadow": {
    "nav":        { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "2px",  "blur": "4px",  "spread": "0px", "color": "rgba(0,0,0,0.06)" } },
    "card":       { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px",  "blur": "8px",  "spread": "0px", "color": "rgba(0,0,0,0.08)" } },
    "card-dark":  { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px",  "blur": "8px",  "spread": "0px", "color": "rgba(0,0,0,0.30)" } },
    "modal":      { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "24px", "blur": "30px", "spread": "0px", "color": "rgba(0,0,0,0.15)" } },
    "modal-dark": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "24px", "blur": "30px", "spread": "0px", "color": "rgba(0,0,0,0.50)" } }
  },
  "size": {
    "button-lg": { "$type": "dimension", "$value": "52px" },
    "button-md": { "$type": "dimension", "$value": "48px" },
    "button-sm": { "$type": "dimension", "$value": "36px" },
    "button-xs": { "$type": "dimension", "$value": "32px" },
    "input":     { "$type": "dimension", "$value": "52px" },
    "input-sm":  { "$type": "dimension", "$value": "44px" },
    "navbar":    { "$type": "dimension", "$value": "64px" },
    "badge":     { "$type": "dimension", "$value": "28px" },
    "control":   { "$type": "dimension", "$value": "20px", "$description": "Checkbox / radio" },
    "avatar": {
      "xl": { "$type": "dimension", "$value": "56px" },
      "lg": { "$type": "dimension", "$value": "48px" },
      "md": { "$type": "dimension", "$value": "44px" },
      "sm": { "$type": "dimension", "$value": "32px" },
      "xs": { "$type": "dimension", "$value": "24px" }
    }
  }
}
